{
  "name": "jiankangshouhuzhe",
  "version": "1.1.0",
  "description": "健康守护者手部康复记录与安全自查应用",
  "author": "健康守护者项目组",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "demo": "node scripts/demo.js",
    "test": "node --test tests/domain/*.test.js && node --test tests/release-site-structure.test.js && node scripts/product-safety-test.js && node scripts/smoke-test.js && node scripts/android-release-contract-test.js",
    "test:domain": "node --test tests/domain/*.test.js",
    "test:product": "node scripts/product-safety-test.js",
    "test:release-site": "node --test tests/release-site-structure.test.js",
    "test:android:release": "node scripts/android-release-contract-test.js",
    "check:syntax": "node --check App.js && node --check server/index.js && node --check server/db.js && node --check server/pages.js && node --check scripts/smoke-test.js && node --check scripts/android-release-contract-test.js && node --check scripts/h5-interaction-layout-check.js && node --check scripts/recovery-journey-web-check.js && node --check scripts/start-wechat-demo.js && node --check scripts/prepare-github-pages.js && node --check scripts/build-release-site.js && node --check scripts/check-release-site.js",
    "server": "node server/index.js",
    "dev:api": "node server/index.js",
    "preview:h5": "node scripts/serve-h5-preview.js",
    "wechat:demo": "node scripts/start-wechat-demo.js",
    "build:web:demo": "expo export --platform web --output-dir dist/wechat-demo",
    "build:pages": "npm run build:web:release && node scripts/prepare-github-pages.js",
    "build:web:release": "node scripts/build-release-site.js",
    "build:static-mirror": "npm run build:web:release",
    "check:web:release": "node scripts/check-release-site.js",
    "check:recovery-web": "node scripts/recovery-journey-web-check.js",
    "export:android": "expo export --platform android --output-dir dist/android",
    "check:h5": "node scripts/h5-interaction-layout-check.js",
    "build:android:aab": "eas build -p android --profile production",
    "build:android:apk": "eas build -p android --profile production-apk",
    "submit:android": "eas submit -p android --profile production",
    "desktop:start": "npm run build:desktop:web && electron desktop/main.cjs",
    "build:desktop:web": "expo export --platform web --output-dir dist/desktop-web --clear",
    "build:desktop:win": "node scripts/ensure-electron-runtime.js && npm run build:desktop:web && electron-builder --win portable zip --x64 --publish never && node scripts/generate-desktop-checksums.js && node scripts/desktop-artifact-smoke.js",
    "test:desktop": "node --test tests/desktop/windows-release.test.js",
    "test:desktop:artifact": "node scripts/desktop-artifact-smoke.js",
    "test:desktop:runtime": "node scripts/desktop-runtime-smoke.js",
    "verify:desktop": "npm run test:desktop && npm run build:desktop:win && npm run test:desktop:runtime"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "expo": "~54.0.33",
    "expo-font": "~14.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0"
  },
  "private": true,
  "devDependencies": {
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "pngjs": "^7.0.0"
  },
  "build": {
    "appId": "com.joyceleo.healthguardian.desktop",
    "productName": "健康守护者",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "artifactName": "HealthGuardian-${version}-Windows-${arch}.${ext}",
    "directories": {
      "output": "dist/windows"
    },
    "files": [
      "desktop/**/*",
      "dist/desktop-web/**/*",
      "assets/icon.png",
      "package.json",
      "!node_modules/**/*",
      "!**/*.map"
    ],
    "extraMetadata": {
      "main": "desktop/main.cjs"
    },
    "win": {
      "icon": "assets/icon.png",
      "executableName": "HealthGuardian",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
